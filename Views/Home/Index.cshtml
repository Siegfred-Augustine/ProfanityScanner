@using System.Text.RegularExpressions
@{
    ViewData["Title"] = "Home Page";

  
    string FormatCensoredText(string input)
    {
        if (string.IsNullOrEmpty(input)) return "";
        return Regex.Replace(input, @"(\*+)", "<span class='asterisk-pill'>$1</span>");
    }
}

<head>
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
</head>

<div class="window-container">
    <div class="main-container">
        <header class="app-header">
            <div class="title-group">
                <h1>Profanity Filter</h1>
                <p>Real-time message monitoring and censorship</p>
            </div>
            <div class="header-buttons">
                <button class="btn btn-view" onclick="toggleSidebar()">
                    <span class="eye-icon">👁</span> View Insights
                </button>
                <button class="btn btn-blue">Admin</button>
            </div>
        </header>

        <main class="content-area">
            <form class="message-form" method="post" asp-action="Index">
                <div class="input-wrapper">
                    <textarea name="inputText" id="txtInput" placeholder="Type your message here..."></textarea>
                    <button type="submit" class="btn-send">
                        <span>➤ Send</span>
                    </button>
                </div>
            </form>

            @* Added wrapping div for scroll functionality *@
            <div class="message-feed">
                @foreach (var message in ProfanityScanner.Models.Classes.Scanner.scannerList)
                {
                    <div class="message-card">
                        <div class="card-meta">
                            <span class="timestamp">@message.dateTime</span>
                            <span class="word-count-badge">
                                ! @message.profaneWords.Count profane word@(message.profaneWords.Count == 1 ? "" : "s")
                            </span>
                        </div>
                        <div class="card-text">
                            @Html.Raw(FormatCensoredText(message.output))
                        </div>
                    </div>
                }
            </div>
        </main>
    </div>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <h3>Profanity Insights</h3>
            <button class="btn-close-sidebar" onclick="toggleSidebar()" aria-label="Close Sidebar">
                <span></span>
                <span></span>
            </button>
        </div>

        <div class="sidebar-scroll-area">
            <div class="sidebar-section">
                <label class="section-label">Identified Profane Words</label>
                <div class="pill-container">
                    @foreach (var word in ProfanityScanner.Models.Classes.Scanner.originalProfane)
                    {
                        <span class="profane-pill red">@word</span>
                    }
                </div>
            </div>

            <div class="sidebar-section">
                <label class="section-label">Summary by Message</label>
                <div class="summary-list">
                    @foreach (var message in ProfanityScanner.Models.Classes.Scanner.scannerList)
                    {
                        <div class="summary-card" onclick="markAsHide(this)">
                            <div class="summary-card-header">
                                <span class="chevron">›</span>
                                <div class="summary-preview">
                                    <p>@Html.Raw(FormatCensoredText(message.output))</p>
                                    <small>@message.dateTime</small>
                                </div>
                                <span class="count-square">@message.profaneWords.Count</span>
                            </div>
                            <div class="summary-card-body">
                                <div class="detail-row">
                                    <p class="label">Original message:</p>
                                    <p class="val">@message.original</p>
                                </div>
                                <div class="detail-row">
                                    <p class="label">Detected words:</p>
                                    <div class="pill-container mini">
                                        @foreach (var word in message.profaneWords)
                                        {
                                            <span class="profane-pill red">@word</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </aside>
</div>

@section Scripts {
    <script>
        function markAsHide(element) {
            element.classList.toggle('active');
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            if (sidebar.style.display === 'none') {
                sidebar.style.display = 'block';
            } else {
                sidebar.style.display = 'none';
            }
        }
    </script>
}