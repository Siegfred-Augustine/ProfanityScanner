
@{
    ViewData["Title"] = "Home Page";
}

<head>
    <link rel="stylesheet" href="~/css/main.css" />
</head>
<div class="window-container">
    <div class="main-container">
        <header>
            <div class="title-container">
                <h1>Profanity Filter</h1>
                <p>Real-time message monitoring and censorship</p>
            </div>
            <div class="insights-btn-container">
                <button class="btn btn-light btn-view-insight">View Insights</button>
            </div>
        </header>
        <main class="text-center messages-container">
            <form class="form-container" method="post" asp-action="Index">
                <textarea name="inputText" id="txtInput" type="text" placeholder="type your message here..."></textarea>
                <button type="submit" class="btn btn-primary mt-2">Scan</button>
            </form>
            <div class="profane-item-container">
                @foreach(var message in ProfanityScanner.Models.Classes.Scanner.scannerList)
                {
                    
                    <div class="message-item">
                        <div class="message-item-header">
                            <p>@message.dateTime</p>
                        </div>
                        <h1>@message.output</h1>                        
                    </div>
                }
            </div>
        </main>
    </div>
    <aside class="sidebar-container r-flex">
        <div class="siderbar-row header-container">
            <h1>Profanity Insights</h1>
        </div>
        <div class="siderbar-row identified-words-container">
            <h1 class="sidebar-row-title">Identified Profane Words</h1>
            <div class="identified-words-list-container">
                @foreach(var message in ProfanityScanner.Models.Classes.Scanner.originalProfane){
                  <p class="identified-profane-item">@message</p>
                }
            </div>
        </div>
        <div class="siderbar-row summary-container">
            <h1 class="sidebar-row-title">Summary By Message</h1>
            <div class="summary-list-container">
                @foreach (var message in ProfanityScanner.Models.Classes.Scanner.scannerList)
                {
                    <div class="summary-list-item" onclick="markAsHide(this)">
                        <div class="sidebar-message-item-container">
                            <div class="sidebar-message-item-header">
                                <h1>@message.output</h1>
                                <p>@message.dateTime</p>
                            </div>

                            <div class="sidebar-message-item-hide hide-content">
                                <div class="sidebar-message-item-content">
                                    <p>Original message:</p>
                                    <h1>@message.original</h1>
                                </div>
                                <div class="sidebar-message-item-detected-words-container">
                                    <p>Detected words:</p>
                                    <div class="sidebar-message-item-detected-words">
                                        @foreach (var word in message.profaneWords)
                                        {
                                            <h1 class="identified-profane-item detected-word-item">@word</h1>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="sidebar-profane-count">
                            @message.profaneWords.Count()
                        </div>
                    </div>
                }
            </div>
        </div>

    </aside>
</div>
<script src="/js/scripts.js"></script>
